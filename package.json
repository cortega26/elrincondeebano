{
  "name": "elrincondeebano",
  "version": "1.5.0",
  "description": "Providing a bilingual-friendly grocery catalog that ships as a static site, pre-caches critical assets, and keeps operations reproducible through scripted builds.",
  "main": "service-worker.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "admin:dev": "npm -w admin/content-manager run dev",
    "admin:build": "npm -w admin/content-manager run build",
    "admin:start": "npm -w admin/content-manager run start",
    "admin:typecheck": "npm -w admin/content-manager run typecheck",
    "admin:test": "npm -w admin/content-manager run test",
    "admin:test:coverage": "npm -w admin/content-manager run test:coverage",
    "admin:test:e2e": "npm -w admin/content-manager run test:e2e",
    "admin:parity": "npm -w admin/content-manager run parity",
    "admin:shadow-read": "npm -w admin/content-manager run shadow-read",
    "admin:certify": "npm -w admin/content-manager run certify",
    "admin:doctor": "npm -w admin/content-manager run doctor",
    "admin:validate": "npm run admin:typecheck && npm run admin:test && npm run admin:build && npm run admin:parity",
    "bootstrap": "npm ci",
    "changeset": "changeset",
    "fonts": "node tools/fetch-fonts.mjs",
    "categories:sync": "node tools/sync-category-catalog.js",
    "preflight": "npm run categories:sync && npm run images:logo && npm run images:avif && npm run images:og:home && npm run images:og:overrides && npm run images:og:categories && npm run images:og:parking && npm run images:og:clean-overrides && node tools/gap-fill-image-variants.js && node admin/content-manager/scripts/migrate-catalog.mjs && node tools/preflight.js",
    "build": "npm run preflight && npm -w astro-poc run build",
    "build:fast": "npm -w astro-poc run build",
    "dev": "npm -w astro-poc run dev",
    "lint:root": "eslint .",
    "lint:astro": "npm -w astro-poc run lint",
    "lint": "npm run lint:root && npm run lint:astro",
    "check:determinism": "node tools/check-determinism-paths.mjs",
    "check:css-order": "node scripts/check-css-order.mjs",
    "check:e2e-selectors": "node tools/check-e2e-class-selectors.mjs",
    "format": "prettier --write .",
    "icons": "node tools/generate-icons.js",
    "validate:categories": "npm run categories:sync && node tools/validate-category-registry.js",
    "images:logo": "node tools/generate-logo-assets.mjs",
    "images:avif": "node tools/sync-avif-assets.js",
    "images:og:home": "node tools/generate-home-og.mjs",
    "images:generate": "node tools/generate-images.mjs",
    "images:og:overrides": "node tools/sync-category-og-overrides.mjs",
    "images:og:categories": "node tools/generate-category-og.mjs",
    "images:og:parking": "node tools/generate-parking-og.mjs",
    "images:og:clean-overrides": "node tools/clean-og-overrides.mjs",
    "canary:post-deploy": "node tools/post-deploy-canary.mjs --base-url https://www.elrincondeebano.com",
    "taxonomy:release": "node tools/taxonomy-release.mjs release",
    "taxonomy:rollback": "node tools/taxonomy-release.mjs rollback",
    "images:rewrite": "node tools/rewrite-images.mjs",
    "lint:images": "node tools/lint-images.mjs",
    "guardrails": "node tools/guardrails/run.mjs",
    "guardrails:assets": "node tools/guardrails/orphan-assets.js --report reports/orphan-assets/latest.json",
    "security:secret-scan": "node tools/guardrails/secret-scan.mjs",
    "ci:guardrails": "npm run build && npm run lint:images && npm run guardrails && npm run guardrails:assets",
    "prune:backups": "node tools/prune-backups.js",
    "test": "vitest run && npm run admin:test",
    "test:coverage": "vitest run --coverage && npm run admin:test:coverage",
    "typecheck:legacy": "tsc -p tsconfig.typecheck.json",
    "typecheck:astro": "npm -w astro-poc run typecheck",
    "typecheck": "npm run typecheck:legacy && npm run typecheck:astro && npm run admin:typecheck",
    "test:e2e": "playwright test -c playwright.astro.config.ts --trace on",
    "test:e2e:astro": "npm run test:e2e",
    "smoke:manual": "node scripts/smoke-checklist.mjs",
    "smoke:evidence": "node scripts/smoke-evidence.mjs",
    "monitor:share-preview": "node tools/share-preview-monitor.mjs --base-url https://www.elrincondeebano.com --timeout-ms 15000 --report reports/share-preview/latest.json",
    "diagnose:share-preview": "node tools/share-preview-diagnose.mjs --base-url https://www.elrincondeebano.com --route / --attempts 5 --report reports/share-preview/diagnostics-home.json",
    "monitor:live-contract": "node tools/live-contract-monitor.mjs --timeout-ms 15000 --sample-size 20 --report reports/live-contract/latest.json",
    "monitor:live-contract:strict": "node tools/live-contract-monitor.mjs --timeout-ms 15000 --sample-size 20 --require-security-headers --report reports/live-contract/latest.json",
    "monitor:live-browser-contract": "node tools/live-browser-contract.mjs --base-url https://www.elrincondeebano.com --timeout-ms 15000 --report reports/live-contract/browser.json",
    "cloudflare:whoami": "npx wrangler whoami",
    "cloudflare:deploy:edge-security-headers": "npx wrangler deploy --config infra/cloudflare/edge-security-headers/wrangler.toml",
    "validate": "npm run lint && npm run typecheck && npm run check:e2e-selectors && npm run build && npm test && npm run check:plans && npm run guardrails:assets",
    "validate:release": "node tools/validate-release.mjs",
    "certify:migration:prepare": "node -e \"const fs=require('fs'); ['build-determinism-a','build-determinism-b'].forEach((p)=>fs.rmSync(p,{recursive:true,force:true}));\"",
    "certify:migration": "npm run certify:migration:prepare && npm run lint && npm run typecheck && npm run build && npm test && npm run test:e2e",
    "lighthouse:audit": "node tools/lighthouse-audit.mjs",
    "snapshot": "node tools/snapshot-site.mjs --tag dev",
    "prepare": "husky",
    "check:plans": "node tools/check-plan-archive.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "astro-poc",
    "admin/content-manager"
  ],
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "chrome-launcher": "^1.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.100.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "undici": "^8.10.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "node": "24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortega26/elrincondeebano.git"
  },
  "bugs": {
    "url": "https://github.com/cortega26/elrincondeebano/issues"
  },
  "homepage": "https://github.com/cortega26/elrincondeebano#readme",
  "lint-staged": {
    "astro-poc/**/*.{astro}": [
      "eslint --no-warn-ignored --config astro-poc/eslint.config.mjs"
    ],
    "astro-poc/**/*.{js,mjs,ts,mts}": [
      "eslint --no-warn-ignored --config astro-poc/eslint.config.mjs",
      "prettier --write"
    ],
    "admin/content-manager/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored --config admin/content-manager/eslint.config.mjs",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --max-warnings=0 --no-warn-ignored --ignore-pattern 'astro-poc/**' --ignore-pattern 'admin/content-manager/**'",
      "prettier --write"
    ],
    "*.{ts,mts}": [
      "eslint --max-warnings=0 --no-warn-ignored --ignore-pattern 'astro-poc/**' --ignore-pattern 'admin/content-manager/**'",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ],
    "plans/**/*.md": [
      "node tools/check-plan-archive.mjs",
      "prettier --write"
    ]
  }
}
