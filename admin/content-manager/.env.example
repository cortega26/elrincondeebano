# Content Manager (TypeScript) environment — copy to .env for local overrides.
# Env vars are read from the process environment; there is no dotenv loader.

# operator | read-only (default: read-only)
ADMIN_MODE=read-only

# Port and bind host (loopback only; non-loopback HOST refuses to start)
PORT=3000
HOST=127.0.0.1

# Repo that this manager reads and writes (default: repo root, two levels up)
# REPO_ROOT=/absolute/path/to/el-rincon-de-ebano

# Launch credential for mutations (plan 071/125). If unset in operator mode,
# a credential is generated and written to data/.admin-credential (0600,
# gitignored); only the path is logged. It is never printed or served.
# ADMIN_CREDENTIAL=

# Remote (OCI) mode: exact HTTPS origin of the admin hostname. Enabling it
# requires x-admin-credential on every /api/v1 request (including health)
# and a deny-by-default Cloudflare Access policy in front of the tunnel.
# See admin/content-manager/README.md "OCI remote mode".
# ADMIN_REMOTE_ORIGIN=

# Optional remote sync API token (used by the sync adapter)
# SYNC_API_TOKEN=
