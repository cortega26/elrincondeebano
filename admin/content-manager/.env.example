# Content Manager (TypeScript) environment — copy to .env for local overrides.
# Env vars are read from the process environment; there is no dotenv loader.

# operator | read-only (default: read-only)
ADMIN_MODE=read-only

# Port and bind host (loopback only; non-loopback HOST refuses to start)
PORT=3000
HOST=127.0.0.1

# Repo that this manager reads and writes (default: repo root, two levels up)
# REPO_ROOT=/absolute/path/to/el-rincon-de-ebano

# Launch credential for mutations (plan 071). If unset, the server generates
# one and prints it once in the startup log in operator mode.
# ADMIN_CREDENTIAL=

# Optional remote sync API token (used by the sync adapter)
# SYNC_API_TOKEN=
