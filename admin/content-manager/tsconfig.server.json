{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "sourceMap": false,
    "outDir": null,
    "rootDir": null,
    "types": ["node"]
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts", "src/domain/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/web"]
}
