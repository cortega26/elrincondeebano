# El Rincón de Ébano — environment variables
# Copy to .env before first run: cp .env.example .env
# See docs/operations/RUNBOOK.md for per-workflow variable requirements.
# All variables are optional unless noted otherwise.
#
# Maintenance rule (plan 204): new process.env.* vars MUST be added here in
# the same commit, grouped with default + owning workflow.

# ---------------------------------------------------------------------------
# Playwright / E2E
# ---------------------------------------------------------------------------

# Port for the local dev server used by Playwright tests.
# Default: 8081
PORT=8081

# Override the base URL Playwright connects to (e.g. point at staging).
# Default: http://127.0.0.1:$PORT
# PLAYWRIGHT_BASE_URL=https://staging.elrincondeebano.com

# Set to "1" to skip the full Astro build step before E2E tests.
# Useful when iterating on tests without changing source (uses existing dist/).
# PLAYWRIGHT_SKIP_BUILD=1

# ---------------------------------------------------------------------------
# Admin / product-data sync (disabled by default)
# Admin launch credential: set ADMIN_CREDENTIAL or let the admin generate one (data/.admin-credential, 0600).
# ---------------------------------------------------------------------------

# Require auth header on every sync request (recommended in production).
# SYNC_API_REQUIRE_AUTH=true

# Fail hard on startup if sync is enabled but API base is not configured.
# SYNC_API_STRICT_STARTUP=true

# Remote API base URL — leave empty to keep sync disabled (default).
# SYNC_API_BASE=

# Sync auth token for the remote API (syncAdapter + conflicts routes).
# SYNC_API_TOKEN=

# ---------------------------------------------------------------------------
# Admin Content Manager (admin/content-manager/src/server/start.ts)
# ---------------------------------------------------------------------------

# Operator mode: read-only (default) or operator (writes enabled).
# ADMIN_MODE=operator

# Bind host for the admin server. Default: 127.0.0.1 (loopback-only).
# HOST=127.0.0.1

# Repo root override (default: auto-detected from CWD).
# REPO_ROOT=/path/to/repo

# Launch credential for operator writes. If absent, the admin generates one
# (data/.admin-credential, 0600) and prints it in the startup log.
# ADMIN_CREDENTIAL=

# Skip the startup recovery check (default: run it). Ephemeral/test only.
# ADMIN_SKIP_RECOVERY_CHECK=1

# ---------------------------------------------------------------------------
# Smoke checks (scripts/smoke-*.mjs)
# ---------------------------------------------------------------------------

# Base URL the smoke checklist probes. Default: http://127.0.0.1:4173
# SMOKE_BASE_URL=http://127.0.0.1:4173

# Evidence metadata attached to smoke reports.
# SMOKE_RUN_URL=
# SMOKE_SIGNED_BY=
# SMOKE_STATUS=pending

# ---------------------------------------------------------------------------
# Image pipeline (tools/, preflight)
# ---------------------------------------------------------------------------

# Skip image optimization entirely (gap-fill + lint-images).
# SKIP_IMAGE_OPT=1

# Skip OpenGraph image generation (parking/home/category generators).
# PREFLIGHT_SKIP_OG=1

# Force regeneration of AVIF assets even when outputs are fresh.
# FULL_REGEN=1

# Override the catalog path for the AVIF sync (tests/isolated runs).
# PRODUCTS_JSON=/tmp/other/product_data.json

# Cloudflare Images switch (preflight): set exactly one, or neither (auto).
# CFIMG_ENABLE=1
# CFIMG_DISABLE=1

# ---------------------------------------------------------------------------
# Fonts (tools/fetch-fonts.mjs)
# ---------------------------------------------------------------------------

# Allow remote font downloads (default: local-only, fails closed).
# ALLOW_REMOTE_FONTS=1

# Extra remote hosts allowed for font fetching (comma/space separated).
# FONTS_REMOTE_HOSTS=fonts.example.com

# Override the font CSS input path / remote CSS URL.
# FONTS_CSS_PATH=
# FONTS_CSS_URL=

# ---------------------------------------------------------------------------
# Backups (tools/prune-backups.js)
# ---------------------------------------------------------------------------

# Extra locations to prune (path.delimiter separated).
# PRUNE_LOCATIONS=/backups/a:/backups/b

# Backup generations to keep. Default: 3
# PRUNE_KEEP=5

# ---------------------------------------------------------------------------
# Build determinism (tools/utils/deterministic-time.js, scripts/)
# ---------------------------------------------------------------------------

# Fixed build timestamp (default: now). CI sets SOURCE_DATE_EPOCH instead.
# BUILD_TIMESTAMP=
# SOURCE_DATE_EPOCH=

# Output root override for the CSS-order check.
# BUILD_OUTPUT_DIR=

# ---------------------------------------------------------------------------
# Lighthouse (tools/lighthouse-audit.mjs)
# ---------------------------------------------------------------------------

# Skip the Astro build before auditing (reuse existing dist/).
# LH_SKIP_BUILD=1

# ---------------------------------------------------------------------------
# CI-provided (do not set locally; listed so `process.env` greps resolve)
# ---------------------------------------------------------------------------

# GITHUB_RUN_ID / GITHUB_SHA — set by GitHub Actions, read by monitors.
# CI_SKIP_BUILD_CONTRACT — test-internal flag, CI only.
