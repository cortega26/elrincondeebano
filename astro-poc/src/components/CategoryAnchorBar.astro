---
// CategoryAnchorBar.astro (Plan 215) — barra pegajosa de chips de ancla para el home.
// Mobile-first: scroll horizontal nativo con scroll-snap, sin dependencias.
// El estado activo (aria-current) lo actualiza el script inline con
// IntersectionObserver; sin JS los chips siguen funcionando como anclas.
export interface AnchorItem {
  /** Texto visible del chip */
  label: string;
  /** Id de la sección destino (sin #) */
  targetId: string;
}

export interface Props {
  items: AnchorItem[];
  className?: string;
}

const { items, className = '' } = Astro.props;
---

{
  items.length > 0 ? (
    <nav class={`anchor-bar ${className}`.trim()} aria-label="Ir a una sección del catálogo">
      <ul class="anchor-bar__list">
        {items.map((item) => (
          <li class="anchor-bar__item">
            <a
              class="anchor-bar__chip"
              href={`#${item.targetId}`}
              data-anchor-target={item.targetId}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ) : null
}

<style>
  .anchor-bar {
    position: sticky;
    top: var(--storefront-header-height);
    z-index: 30;
    margin-inline: calc(-1 * var(--bs-gutter-x, 1.5rem) / 2);
    padding: 0.5rem calc(var(--bs-gutter-x, 1.5rem) / 2);
    margin-bottom: 1rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 244, 238, 0.94));
    border-bottom: 1px solid rgba(18, 59, 53, 0.08);
  }

  .anchor-bar__list {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0.15rem 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .anchor-bar__list::-webkit-scrollbar {
    display: none;
  }

  .anchor-bar__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .anchor-bar__chip {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 999px;
    background: var(--surface-color);
    color: var(--text-color);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    touch-action: manipulation;
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .anchor-bar__chip:hover {
    border-color: rgba(0, 91, 79, 0.35);
    background-color: var(--primary-soft);
    color: var(--primary-color);
  }

  .anchor-bar__chip[aria-current='true'] {
    border-color: var(--primary-color);
    background-color: var(--primary-color);
    color: #fff;
  }

  /* Las secciones destino deben quedar bajo el header fijo + esta barra. */
  :global(.home-layout__quick-order),
  :global(.home-layout__deals),
  :global(.home-layout__bundles),
  :global(.home-layout__catalog) section {
    scroll-margin-top: calc(var(--storefront-header-height) + 3.75rem);
  }

  @media (min-width: 992px) {
    .anchor-bar {
      margin-inline: 0;
      border: 1px solid rgba(18, 59, 53, 0.08);
      border-radius: 12px;
    }

    .anchor-bar__list {
      justify-content: center;
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }
</style>

<script>
  // Resalta el chip de la sección visible (banda media del viewport).
  // Sin IntersectionObserver no se hace nada: los chips siguen siendo anclas.
  function initAnchorBar() {
    const bar = document.querySelector('.anchor-bar');
    if (!bar || bar.getAttribute('data-anchor-bound') === 'true') return;
    bar.setAttribute('data-anchor-bound', 'true');

    const chips = Array.from(
      bar.querySelectorAll<HTMLAnchorElement>('[data-anchor-target]')
    );
    if (chips.length === 0 || typeof IntersectionObserver === 'undefined') return;

    const targets = chips
      .map((chip) => document.getElementById(chip.getAttribute('data-anchor-target') || ''))
      .filter((el): el is HTMLElement => el instanceof HTMLElement);
    if (targets.length === 0) return;

    const setActive = (id: string | null) => {
      chips.forEach((chip) => {
        if (chip.getAttribute('data-anchor-target') === id) {
          chip.setAttribute('aria-current', 'true');
        } else {
          chip.removeAttribute('aria-current');
        }
      });
    };

    const visible = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = (entry.target as HTMLElement).id;
          if (entry.isIntersecting) {
            visible.set(id, entry.intersectionRatio);
          } else {
            visible.delete(id);
          }
        });
        let best: string | null = null;
        let bestRatio = 0;
        visible.forEach((ratio, id) => {
          if (ratio > bestRatio) {
            bestRatio = ratio;
            best = id;
          }
        });
        setActive(best);
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    targets.forEach((target) => observer.observe(target));
  }

  initAnchorBar();
  document.addEventListener('astro:page-load', initAnchorBar);
</script>
