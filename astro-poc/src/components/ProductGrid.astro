---
import ProductCard from './ProductCard.astro';
import type { ProductWithSku } from '../lib/catalog';

export interface Props {
  items: ProductWithSku[];
  id?: string;
  className?: string;
  announce?: boolean;
  compactMobile?: boolean;
  /** Plan 286: at most one grid per page may prioritize its first image. */
  prioritizeFirst?: boolean;
}

const {
  items,
  id,
  className = '',
  announce = false,
  compactMobile = false,
  prioritizeFirst = true,
} = Astro.props;
---

<div
  class={`row ${className}`.trim()}
  id={id}
  aria-live={announce ? 'polite' : undefined}
  data-total-products={items.length}
>
  {items.map((item, index) => <ProductCard item={item} index={index} compactMobile={compactMobile} priority={prioritizeFirst && index === 0} />)}
</div>
