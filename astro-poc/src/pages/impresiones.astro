---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createSharePreviewMetadata, DEFAULT_OG_IMAGE } from '../lib/seo';
import { calculatePrintingQuote, buildPrintingWhatsAppUrl } from '../lib/printing-pricing.js';
import { formatCurrency } from '../lib/formatting.js';
import '../styles/printing.css';

const initialQuote = calculatePrintingQuote(1, 0);
const oficioQuote = calculatePrintingQuote(1, 1, 'oficio');
const initialWhatsAppUrl = buildPrintingWhatsAppUrl(initialQuote);
const printingTerms = [
  'Los precios indicados corresponden a impresiones y fotocopias en papel bond de 75 g/m², tamaño carta u oficio, a una cara y con cobertura de tinta normal.',
  `Oficio tiene un recargo de ${formatCurrency(oficioQuote.blackAndWhiteUnitPrice - initialQuote.blackAndWhiteUnitPrice)} por página B/N y ${formatCurrency(oficioQuote.colorUnitPrice - initialQuote.colorUnitPrice)} por página a color respecto de carta.`,
  'Las imágenes a página completa y los pedidos de gran volumen requieren cotización previa.',
  'Si necesitas fotocopiar documentos físicos, coordinamos la recepción y devolución de los originales.',
].join(' ');
const sharePreview = createSharePreviewMetadata({
  title: 'Impresiones y fotocopias en Ébano | El Rincón de Ébano',
  description:
    'Imprime documentos en blanco y negro o color sin salir del edificio Ébano. Calcula tu precio y coordina por WhatsApp.',
  canonicalPath: '/impresiones/',
  ogImage: DEFAULT_OG_IMAGE,
  ogImageAlt: 'El Rincón de Ébano: impresiones y fotocopias para residentes',
});
---

<BaseLayout
  title={sharePreview.title}
  description={sharePreview.description}
  canonicalPath="/impresiones/"
  sharePreview={sharePreview}
  showTrustStrip={false}
  hideCartShortcut={true}
>
  <div class="printing-page">
    <nav class="printing-breadcrumb" aria-label="Ruta de navegación">
      <a href="/">El Rincón de Ébano</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Impresiones</span>
    </nav>

    <section class="printing-hero" aria-labelledby="printing-heading">
      <div class="printing-hero__copy">
        <p class="printing-eyebrow">Un servicio más, exclusivo para vecinos de Ébano</p>
        <h1 id="printing-heading">Lo necesitas impreso.<br /><span>Lo resuelves aquí.</span></h1>
        <p class="printing-hero__lead">
          Documentos, formularios, tareas y contratos en blanco y negro o color.
          Cotiza en segundos. Comparte el archivo desde tu dispositivo o coordina la recepción de originales físicos por WhatsApp; entregamos dentro del edificio.
        </p>
        <div class="printing-benefits" aria-label="Ventajas del servicio">
          <span>Sin desplazarte</span>
          <span>Precio claro antes de pedir</span>
          <span>Atención por WhatsApp</span>
        </div>
        <a class="printing-hero__secondary" href="#como-funciona">
          Cómo funciona el servicio <span aria-hidden="true">↓</span>
        </a>
      </div>

      <aside class="printing-quote" id="cotizador" aria-labelledby="printing-quote-heading" data-printing-calculator>
        <div class="printing-quote__heading">
          <p class="printing-eyebrow">Cotización instantánea</p>
          <h2 id="printing-quote-heading">Calcula tu impresión</h2>
          <p>Elige el tipo de solicitud y cuántas páginas impresas finales necesitas. Puedes combinar blanco y negro con color.</p>
        </div>

        <fieldset class="printing-source" aria-describedby="printing-source-help">
          <legend>¿Qué necesitas hacer?</legend>
          <div class="printing-source__choices">
            <label>
              <input type="radio" name="printing-source" value="archivo" checked />
              <span><strong>Imprimir archivo</strong><small>PDF, Word o imagen digital</small></span>
            </label>
            <label>
              <input type="radio" name="printing-source" value="original" />
              <span><strong>Fotocopiar originales</strong><small>Documentos físicos en papel</small></span>
            </label>
          </div>
          <p id="printing-source-help">No es necesario tomar fotografías de documentos físicos para solicitar fotocopias.</p>
        </fieldset>

        <div class="printing-quote__format">
          <label for="printing-paper-size">
            <strong>Formato del papel</strong>
            <small>Papel bond de 75 g/m² · a una cara</small>
          </label>
          <select id="printing-paper-size" aria-describedby="printing-format-note">
            <option value="carta" selected>Carta · B/N {formatCurrency(initialQuote.blackAndWhiteUnitPrice)} · color {formatCurrency(initialQuote.colorUnitPrice)}</option>
            <option value="oficio">Oficio · B/N {formatCurrency(oficioQuote.blackAndWhiteUnitPrice)} · color {formatCurrency(oficioQuote.colorUnitPrice)}</option>
          </select>
          <p id="printing-format-note">Oficio: +{formatCurrency(oficioQuote.blackAndWhiteUnitPrice - initialQuote.blackAndWhiteUnitPrice)} por página B/N y +{formatCurrency(oficioQuote.colorUnitPrice - initialQuote.colorUnitPrice)} por página color. El cargo de atención no cambia.</p>
        </div>

        <div class="printing-quote__inputs">
          <div class="printing-quote__input-row">
            <label for="printing-bw">
              <strong>Blanco y negro</strong>
              <small id="printing-bw-unit-price">{formatCurrency(initialQuote.blackAndWhiteUnitPrice)} por página</small>
            </label>
            <div class="printing-quote__quantity" role="group" aria-label="Ajustar páginas en blanco y negro">
              <button class="printing-quote__step" type="button" data-printing-target="printing-bw" data-printing-delta="-1" aria-controls="printing-bw" aria-label="Quitar una página en blanco y negro">−</button>
              <input id="printing-bw" type="number" inputmode="numeric" min="0" max="500" step="1" value="1" aria-describedby="printing-limit" />
              <button class="printing-quote__step" type="button" data-printing-target="printing-bw" data-printing-delta="1" aria-controls="printing-bw" aria-label="Agregar una página en blanco y negro">+</button>
            </div>
          </div>
          <div class="printing-quote__input-row">
            <label for="printing-color">
              <strong>A color</strong>
              <small id="printing-color-unit-price">{formatCurrency(initialQuote.colorUnitPrice)} por página</small>
            </label>
            <div class="printing-quote__quantity" role="group" aria-label="Ajustar páginas a color">
              <button class="printing-quote__step" type="button" data-printing-target="printing-color" data-printing-delta="-1" aria-controls="printing-color" aria-label="Quitar una página a color" disabled>−</button>
              <input id="printing-color" type="number" inputmode="numeric" min="0" max="500" step="1" value="0" aria-describedby="printing-limit" />
              <button class="printing-quote__step" type="button" data-printing-target="printing-color" data-printing-delta="1" aria-controls="printing-color" aria-label="Agregar una página a color">+</button>
            </div>
          </div>
          <p class="printing-quote__input-hint" id="printing-limit">Indica páginas finales impresas, no archivos u originales. Por ejemplo, 3 copias de 2 páginas son 6 páginas. Hasta 500 por tipo; cantidades mayores se cotizan aparte.</p>
        </div>

        <div id="printing-digital-section" class="printing-request-details">
          <label for="printing-file"><strong>Seleccionar documento</strong> <span>(opcional)</span></label>
          <input
            type="file"
            id="printing-file"
            accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png"
            aria-describedby="printing-file-feedback printing-file-privacy"
          />
          <p id="printing-file-feedback" role="status" aria-live="polite">Puedes seleccionar un archivo para compartirlo junto a la cotización, o adjuntarlo después en WhatsApp.</p>
          <p id="printing-file-privacy">PDF, Word, JPG o PNG; máximo 15 MB. El archivo permanece en tu dispositivo hasta que decidas compartirlo con una aplicación. No se sube a este sitio. Para evitar cambios de formato, recomendamos PDF.</p>
        </div>

        <div id="printing-physical-section" class="printing-request-details printing-request-details--physical" hidden>
          <strong>Fotocopias de originales físicos</strong>
          <p>Calcula la cantidad de páginas finales. Al solicitar, coordinaremos por WhatsApp cómo recibir y devolver los originales dentro del edificio. Confirmaremos el precio y la cantidad después de revisarlos.</p>
          <p>No tienes que fotografiar ni subir los documentos.</p>
        </div>

        <div class="printing-quote__breakdown" aria-label="Detalle del precio estimado">
          <div class="printing-quote__line">
            <span>Atención y entrega <small>(una vez por pedido)</small></span>
            <output id="printing-service-cost">{formatCurrency(initialQuote.serviceCost)}</output>
          </div>
          <div class="printing-quote__line">
            <span>Páginas B/N</span>
            <output id="printing-bw-cost">{formatCurrency(initialQuote.blackAndWhiteCost)}</output>
          </div>
          <div class="printing-quote__line">
            <span>Páginas color</span>
            <output id="printing-color-cost">{formatCurrency(initialQuote.colorCost)}</output>
          </div>
        </div>

        <div class="printing-quote__total" role="status" aria-live="polite" aria-atomic="true">
          <span>Total estimado</span>
          <output id="printing-total">{formatCurrency(initialQuote.total)}</output>
        </div>
        <p class="printing-quote__error" id="printing-error" aria-live="polite"></p>

        <button id="printing-share-file" class="btn btn-primary printing-quote__cta printing-quote__share" type="button" hidden>
          Compartir archivo y cotización <span aria-hidden="true">↗</span>
        </button>
        <p class="printing-quote__share-help">Al compartir, selecciona WhatsApp y la conversación correcta. Comprueba que se incluyan archivo y resumen; algunas aplicaciones pueden omitir el texto.</p>
        <p id="printing-share-feedback" class="printing-quote__share-feedback" role="status" aria-live="polite"></p>

        <a
          id="printing-whatsapp"
          class="btn btn-primary printing-quote__cta"
          href={initialWhatsAppUrl ?? undefined}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span id="printing-whatsapp-label">Enviar cotización por WhatsApp</span> <span aria-hidden="true">↗</span>
        </a>
        <p class="printing-quote__disclaimer">
          No se cobra ni se reciben archivos en esta web. Compartir no equivale a confirmar un pedido.
          En WhatsApp verificamos detalles, disponibilidad y precio final.
        </p>
      </aside>
    </section>

    <section class="printing-how" id="como-funciona" aria-labelledby="printing-how-heading">
      <div class="printing-section-header">
        <p class="printing-eyebrow">Simple y cerca</p>
        <h2 id="printing-how-heading">Tres pasos. Sin salir de casa.</h2>
      </div>
      <div class="printing-how__grid">
        <article class="printing-how__step">
          <span class="printing-how__number" aria-hidden="true">01</span>
          <h3>Calcula</h3>
          <p>Elige impresión digital o fotocopia física, formato carta u oficio y páginas finales B/N y color. El cargo de atención se aplica una vez.</p>
        </article>
        <article class="printing-how__step">
          <span class="printing-how__number" aria-hidden="true">02</span>
          <h3>Envía</h3>
          <p>Para impresión digital, comparte el archivo desde el teléfono o adjúntalo al chat. Para fotocopias, coordinamos la recepción de originales físicos.</p>
        </article>
        <article class="printing-how__step">
          <span class="printing-how__number" aria-hidden="true">03</span>
          <h3>Recibe</h3>
          <p>Confirmamos las páginas, la disponibilidad y el precio final. Entregamos las impresiones y, cuando corresponda, devolvemos los originales.</p>
        </article>
      </div>
    </section>

    <section class="printing-terms" aria-labelledby="printing-terms-heading">
      <div>
        <h2 id="printing-terms-heading">Para que sepas exactamente qué estás cotizando</h2>
        <p>{printingTerms}</p>
      </div>
      <a href="/" class="printing-terms__link">Volver al minimarket <span aria-hidden="true">→</span></a>
    </section>
  </div>

  <script>
    import '../scripts/printing-quote.js';
  </script>
</BaseLayout>
